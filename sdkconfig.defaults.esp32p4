CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Размер флеша (16 МБ), таблица разделов (partitions/v2/16m.csv, offset 0x8000)
# уже заданы в общем sdkconfig.defaults — здесь дублировать не нужно.

# --- Guition JC1060P470C (плата по умолчанию в этом форке) ---
CONFIG_BOARD_TYPE_GUITION_JC1060P470=y

# ESP32-P4 engineering sample rev 1.0 / 1.3 (JC1060P470C).
# Без этих двух строк на v1.0/v1.3 прошивка не загрузится (Illegal Instruction);
# REV_MIN_100 разрешает флеш 80 МГц (при REV_MIN_0 дефолт — 40 МГц).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Wi-Fi через ESP32-C6 (ESP-Hosted, SDIO)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# Пул буферов SDIO-транспорта (~31 блок x 1536 б = ~48 КБ непрерывной
# internal DMA RAM) выделять из DMA-capable PSRAM: на P4 GDMA достаёт
# PSRAM через cache. Без этого после LVGL/аудио esp_hosted не находит
# непрерывный кусок internal RAM и падает:
#   assert failed: sdio_mempool_create sdio_drv.c:258 (buf_mp_g)
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Флеш на этой плате — Boya (иначе предупреждение в логе и generic-драйвер)
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# --- Аудио/речь (ES8311 на Guition + AFE wake word) ---
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_SEND_WAKE_WORD_DATA=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
# Облегчённая версия того же слова пробуждения: оба модель-входа попадают в
# srmodels.bin, что повышает recall. Раньше эта опция ставилась только руками
# через menuconfig и терялась при пересоздании sdkconfig.
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
CONFIG_CODEC_ES8311_SUPPORT=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# External OV02C10 compatibility driver registers through the esp_cam_sensor
# detector linker section; force the dynamic detector-store mode so the
# out-of-tree detector is actually visible to esp_video auto-detection.
CONFIG_CAMERA_SENSOR_MOTOR_DETECT_METHOD_DYNAMIC_LINK=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

CONFIG_LV_USE_SNAPSHOT=y

# --- Эхоподавление / полный дуплекс ---
# У ES8311 нет аппаратного возврата сигнала воспроизведения на АЦКП, поэтому
# опорный канал синтезируется в софте Es8311AudioCodec (кольцо копии вывода,
# BOARD_TYPE_GUITION_JC1060P470 добавлен в whitelist USE_DEVICE_AEC).
# С включённым AEC слушание переходит в kListeningModeRealtime (full-duplex).
CONFIG_USE_DEVICE_AEC=y

# Глаза EmoteDisplay (esp_emote_gfx) + собственный набор «мудрый гуру»
# (main/assets/emote-guru). Возврат к чату на LVGL 9 (MipiLcdDisplay, экран
# настроек lvgl_audio_settings с lv_button/lv_slider):
#   CONFIG_USE_WECHAT_MESSAGE_STYLE=y
#   CONFIG_USE_EMOTE_MESSAGE_STYLE=n
CONFIG_USE_EMOTE_MESSAGE_STYLE=y
CONFIG_LANGUAGE_RU_RU=y

# Имена файлов в образе ассетов хранятся в таблице esp_mmap_assets фиксированной
# длины; на дефолтных 16 байтах «font_noto_sans_common_20_4.bin» обрезается до
# «font_noto_sans_c», и emote_load_fonts ищет его по полному имени:
#   E Expression_load: Font file not found: font_noto_sans_common_20_4.bin
# То есть русский текст в EmoteDisplay остаётся без шрифта. 32 байта — ровно то,
# что ставят тестовые приложения esp_emote_* / image_player (см. их
# sdkconfig.defaults); образ пересобирается тем же значением, так что обе стороны
# сходятся.
CONFIG_MMAP_FILE_NAME_LENGTH=32

CONFIG_ESP_HOSTED_FW_VERSION_MISMATCH_WARNING_SUPPRESS=y
