CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Размер флеша (16 МБ), таблица разделов (partitions/v2/16m.csv, offset 0x8000)
# уже заданы в общем sdkconfig.defaults — здесь дублировать не нужно.

# --- Guition JC1060P470C (плата по умолчанию в этом форке) ---
CONFIG_BOARD_TYPE_GUITION_JC1060P470=y

# ESP32-P4 engineering sample rev 1.0 / 1.3 (JC1060P470C).
# Без этих двух строк на v1.0/v1.3 прошивка не загрузится (Illegal Instruction);
# REV_MIN_100 разрешает флеш 80 МГц (при REV_MIN_0 дефолт — 40 МГц).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=102400
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Wi-Fi через ESP32-C6 (ESP-Hosted, SDIO)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# Пул буферов SDIO-транспорта (~31 блок x 1536 б = ~48 КБ непрерывной
# internal DMA RAM) выделять из DMA-capable PSRAM: на P4 GDMA достаёт
# PSRAM через cache. Без этого после LVGL/аудио esp_hosted не находит
# непрерывный кусок internal RAM и падает:
#   assert failed: sdio_mempool_create sdio_drv.c:258 (buf_mp_g)
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# Флеш на этой плате — Boya (иначе предупреждение в логе и generic-драйвер)
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=y

# --- Аудио/речь (ES8311 на Guition + AFE wake word) ---
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_SEND_WAKE_WORD_DATA=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_CODEC_ES8311_SUPPORT=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_OV02C10=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024

CONFIG_LV_USE_SNAPSHOT=y

CONFIG_USE_WECHAT_MESSAGE_STYLE=n
CONFIG_USE_DEFAULT_MESSAGE_STYLE=y
CONFIG_LANGUAGE_ZH_CN=y
